# Variaveis de build do Vite (inlinadas no bundle JS - NUNCA coloque secrets aqui)
# Estas variaveis sao substituidas em tempo de build pelo CI/CD

# URL base da API (sem trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# URL base do WebSocket para market data
VITE_WS_BASE_URL=ws://localhost:3000

# IMPORTANTE: Credenciais, chaves HMAC, tokens e qualquer informacao sensivel
# devem ficar EXCLUSIVAMENTE no backend (env vars do servidor, cofre de segredos).
# Variaveis VITE_* sao publicas - qualquer usuario pode ve-las no DevTools.
